generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HabitTrackingType {
  SIMPLE_CHECKIN
  QUANTITATIVE

  @@map("habit_tracking_type")
}

enum HabitLogStatus {
  DONE
  PARTIAL
  NOT_DONE

  @@map("habit_log_status")
}

enum HabitLifecycleStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("habit_lifecycle_status")
}

enum CompletionTriggerSource {
  SELF_INITIATED
  REMINDER_TRIGGERED
  MANUAL_ENTRY

  @@map("completion_trigger_source")
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("weekday")
}

enum CueDayType {
  ANY
  WEEKDAY
  WEEKEND

  @@map("cue_day_type")
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  email        String            @unique
  passwordHash String            @map("password_hash")
  displayName  String?           @map("display_name")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  habits       Habit[]
  activityLogs UserActivityLog[]

  @@map("users")
}

model Habit {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String                 @map("user_id") @db.Uuid
  title                  String
  description            String?
  trackingType           HabitTrackingType      @map("tracking_type")
  allowPartialCompletion Boolean                @default(false) @map("allow_partial_completion")
  measurementUnit        String?                @map("measurement_unit")
  targetValue            Float?                 @map("target_value")
  minimumSuccessValue    Float?                 @map("minimum_success_value")
  startDate              DateTime               @map("start_date") @db.Date
  status                 HabitLifecycleStatus   @default(ACTIVE)
  reminderEnabled        Boolean                @default(false) @map("reminder_enabled")
  archivedAt             DateTime?              @map("archived_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduleDays           HabitScheduleDay[]
  cues                   HabitCue[]
  motivationProfile      HabitMotivationProfile?
  logs                   HabitLog[]

  @@index([userId])
  @@index([status])
  @@map("habits")
}

model HabitScheduleDay {
  id        String   @id @default(uuid()) @db.Uuid
  habitId   String   @map("habit_id") @db.Uuid
  weekday   Weekday
  createdAt DateTime @default(now()) @map("created_at")
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, weekday])
  @@index([habitId])
  @@map("habit_schedule_days")
}

model HabitCue {
  id               String     @id @default(uuid()) @db.Uuid
  habitId          String     @map("habit_id") @db.Uuid
  timeWindow       String?    @map("time_window")
  dayType          CueDayType @default(ANY) @map("day_type")
  coarseLocation   String?    @map("coarse_location")
  precedingRoutine String?    @map("preceding_routine")
  isActive         Boolean    @default(true) @map("is_active")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  habit            Habit      @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
  @@map("habit_cues")
}

model HabitMotivationProfile {
  id                String   @id @default(uuid()) @db.Uuid
  habitId           String   @unique @map("habit_id") @db.Uuid
  goalTag           String?  @map("goal_tag")
  personalReason    String?  @map("personal_reason")
  identityStatement String?  @map("identity_statement")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  habit             Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@map("habit_motivation_profiles")
}

model HabitLog {
  id            String                   @id @default(uuid()) @db.Uuid
  habitId       String                   @map("habit_id") @db.Uuid
  status        HabitLogStatus
  actualValue   Float?                   @map("actual_value")
  completedAt   DateTime                 @map("completed_at")
  loggedAt      DateTime                 @default(now()) @map("logged_at")
  triggerSource CompletionTriggerSource? @map("trigger_source")
  habit         Habit                    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId, completedAt])
  @@index([habitId, loggedAt])
  @@index([triggerSource])
  @@map("habit_logs")
}

model UserActivityLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  activityType String   @map("activity_type")
  occurredAt   DateTime @default(now()) @map("occurred_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("user_activity_logs")
}
