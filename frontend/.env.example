# Frontend environment variables (Vite).
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Only variables prefixed with `VITE_` are exposed to client code.

# Backend API base URL. Defaults to `/api` (same-origin) when unset.
VITE_API_URL=http://localhost:3000

# Set to `true` to use the in-memory mock router instead of the live backend.
VITE_USE_MOCK=false

# Web Push public key (must match the backend's VAPID_PUBLIC_KEY).
VITE_VAPID_PUBLIC_KEY=

# Documentation-only — these are NOT read by Vite (no VITE_ prefix). Kept here
# to record the production app/CORS origin used by the backend deployment.
APP_ORIGIN=https://habit-system-production-94e3.up.railway.app
CORS_ORIGINS=https://habit-system-production-94e3.up.railway.app
